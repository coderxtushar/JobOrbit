# Copy to .env.local. Read only by the Next.js server; nothing here reaches the browser.

# Where the JobOrbit FastAPI backend listens.
JOBORBIT_API_URL=http://127.0.0.1:8000

# Only if the backend requires a bearer token (JA_API_TOKEN). The dashboard's server-side
# proxy adds it to every request, so the token is never sent to the browser.
JOBORBIT_API_TOKEN=

# ---------- Hosted sign-in (optional) ----------
# "google" requires everyone to sign in with Google before using the workspace. Leave empty
# for a local, single-person install.
JOBORBIT_AUTH=
# From Google Cloud Console > Credentials > OAuth client ID (type: Web application), with
# the redirect URI <site>/api/auth/google/callback. The secret stays on this server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# The site's public URL, if it differs from what the server sees (behind a proxy).
JOBORBIT_PUBLIC_URL=
# A separate demo API for signed-out visitors who press "Try the demo" (optional).
JOBORBIT_DEMO_API_URL=
JOBORBIT_DEMO_API_TOKEN=
