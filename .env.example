# Copy to .env and edit. Never commit .env.
# Every value below has a safe default; the app runs with no .env at all.

# ---------- Server ----------
# Bind to loopback only. Changing this exposes your resume data on the network.
JA_API_HOST=127.0.0.1
JA_API_PORT=8000
# Must be set to a non-empty token if JA_API_HOST is not a loopback address.
JA_API_TOKEN=
JA_LOG_LEVEL=INFO
# Display timezone for the dashboard. All timestamps are STORED in UTC.
JA_DISPLAY_TIMEZONE=Asia/Kolkata

# ---------- Storage ----------
# SQLAlchemy URL. SQLite by default; PostgreSQL works unchanged
# (e.g. postgresql+psycopg://user:pass@localhost:5432/jobassist)
JA_DATABASE_URL=sqlite+pysqlite:///./var/jobassist.db
# Private data directory, never served statically.
JA_DATA_DIR=./var
JA_MAX_UPLOAD_MB=10

# ---------- LLM (entirely optional) ----------
# Leave JA_LLM_PROVIDER=none to run with deterministic, rule-based generation.
# Supported: none | openai | openai_compatible
JA_LLM_PROVIDER=none
JA_LLM_MODEL=gpt-4o-mini
JA_LLM_API_KEY=
JA_LLM_BASE_URL=
JA_LLM_TIMEOUT_SECONDS=60

# ---------- Scheduler ----------
# Off by default. No background activity happens unless you enable this.
JA_SCHEDULER_ENABLED=false
JA_DISCOVERY_INTERVAL_MINUTES=360

# ---------- Email job-alert ingestion (optional, opt-in) ----------
# Disabled by default. Requires an app-specific password, read-only usage.
# Your password is read from the environment and never written to the database.
JA_EMAIL_INGEST_ENABLED=false
JA_EMAIL_IMAP_HOST=
JA_EMAIL_IMAP_PORT=993
JA_EMAIL_USERNAME=
JA_EMAIL_APP_PASSWORD=
JA_EMAIL_FOLDER=INBOX

# ---------- ATS job-board discovery (per-company, published board APIs) ----------
# Greenhouse, Lever, Workable, Ashby and SmartRecruiters each publish an unauthenticated
# endpoint that serves one company's own job board. Nothing is fetched until you name the
# companies here: there is no built-in list, because that would turn a targeted lookup
# into a crawl.
# Greenhouse:      the slug in boards.greenhouse.io/<slug>
# Lever:           the slug in jobs.lever.co/<slug>
# Workable:        the subdomain in <sub>.workable.com
# Ashby:           the slug in jobs.ashbyhq.com/<slug>
# SmartRecruiters: the identifier in careers.smartrecruiters.com/<id>
JA_ATS_DISCOVERY_ENABLED=true
JA_GREENHOUSE_BOARDS=
JA_LEVER_BOARDS=
JA_WORKABLE_BOARDS=
JA_ASHBY_BOARDS=
JA_SMARTRECRUITERS_BOARDS=
JA_ATS_TIMEOUT_SECONDS=20
JA_ATS_MAX_ATTEMPTS=3
# Page cap per board. SmartRecruiters returns 100 postings a page, so a large employer
# needs several; the cap is what stops an unbounded walk.
JA_ATS_MAX_PAGES=20
# SmartRecruiters' postings list carries no description; each one costs an extra request
# to its per-posting endpoint. Postings past this cap are still imported, with an empty
# description, and score as sparse rather than as a false match.
JA_SMARTRECRUITERS_DETAIL_LIMIT=60

# ---------- Open job-feed discovery (whole-feed APIs, off by default) ----------
# These publish one feed covering every employer, not a single company's board, so each
# publisher's own terms govern. Both the master switch and the per-source switch must be
# true before any request is made. See docs/SOURCES.md for each publisher's notice.
# Remotive is deliberately never paginated: its notice advises ~4 requests a day.
JA_FEED_DISCOVERY_ENABLED=false
JA_ARBEITNOW_ENABLED=false
JA_REMOTEOK_ENABLED=false
JA_REMOTIVE_ENABLED=false
JA_HIMALAYAS_ENABLED=false
JA_JOBICY_ENABLED=false
JA_FEED_MAX_PAGES=3

# ---------- Bulk preparation ----------
# Concurrency overlaps per-job work. On SQLite writers are still serialised, so values
# above about 4 buy little. Preparation never submits anything.
JA_BATCH_CONCURRENCY=4
JA_BATCH_MAX_ATTEMPTS=3
JA_BATCH_MAX_JOBS=500
